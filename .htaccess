AddDefaultCharset utf-8

# Allow direct access to whatsapp PDFs
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/uploads/whatsapp_invoices/.*\.pdf$ [NC]
    RewriteRule ^ - [L]
</IfModule>

<FilesMatch "\.(pdf)$">
    Require all granted
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine on

# ✅ Allow direct access to cron.php
RewriteCond %{REQUEST_URI} ^/cron.php$ [NC]
RewriteRule ^ - [L]

# Existing rules
RewriteCond $1 !^(index\.php|resources|robots\.txt|cron\.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>
